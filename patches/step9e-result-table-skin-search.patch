+bool OsuBanchoApi::getCachedRank(float pp, int &globalRank, bool &estimated)
+{
+	std::lock_guard<std::mutex> lock(g_mutex);
+	std::map<long, RankResult>::iterator it = g_rankCache.find(ppKey(pp));
+	if (it == g_rankCache.end() || it->second.globalRank <= 0) return false;
+	globalRank = it->second.globalRank;
+	estimated = it->second.globalEstimated;
+	return true;
+}
