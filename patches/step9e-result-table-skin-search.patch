diff --git a/src/App/Osu/OsuResultStats.cpp b/src/App/Osu/OsuResultStats.cpp
new file mode 100644
index 0000000..3e09b9b
--- /dev/null
+++ b/src/App/Osu/OsuResultStats.cpp
@@ -0,0 +1,322 @@
+//================ myosu: result screen stats table ================//
+//
+// Purpose:		table at the bottom of the result screen (like osu! after a submit):
+//				this play + overall profile stats, each with the change.
+//
+//===============================================================================//
+
+#include "OsuResultStats.h"
+
+#include "Engine.h"
+#include "ConVar.h"
+#include "Font.h"
+
+#include "Osu.h"
+#include "OsuScore.h"
+#include "OsuSongBrowser2.h"
+#include "OsuDatabase.h"
+#include "OsuBanchoApi.h"
+
+#include <string>
+#include <vector>
+#include <cmath>
+#include <algorithm>
+
+namespace
+{
+	struct Overall
+	{
+		float pp = 0.0f;
+		float accuracy = 0.0f;
+		int maxCombo = 0;
+		unsigned long long rankedScore = 0;
+		unsigned long long totalScore = 0;
+	};
+
+	Osu *g_osu = NULL;
+	bool g_bValid = false;
+	bool g_bShowing = false;
+
+	Overall g_before;
+	Overall g_after;
+
+	// this play
+	unsigned long long g_playScore = 0;
+	int g_playCombo = 0;
+	float g_playAccuracy = 0.0f;
+	float g_playPP = 0.0f;
+	int g_localPlace = 0;
+	int g_beatmapID = 0;
+	bool g_bNewBest = false;
+
+	Overall computeOverall(Osu *osu)
+	{
+		Overall o;
+		OsuDatabase *db = osu->getSongBrowser()->getDatabase();
+		ConVar *nameCvar = convar->getConVarByName("name", false);
+		const UString name = (nameCvar != NULL ? nameCvar->getString() : UString("Guest"));
+
+		const OsuDatabase::PlayerStats stats = db->calculatePlayerStats(name);
+		o.pp = stats.pp;
+		o.accuracy = stats.accuracy;
+		o.rankedScore = stats.totalScore;
+
+		std::unordered_map<std::string, std::vector<OsuDatabase::Score>> *scores = db->getScores();
+		for (auto &entry : *scores)
+		{
+			for (const OsuDatabase::Score &score : entry.second)
+			{
+				if (score.playerName != name) continue;
+				o.totalScore += score.score;
+				o.maxCombo = std::max(o.maxCombo, score.comboMax);
+			}
+		}
+		return o;
+	}
+
+	std::string withDots(unsigned long long value)
+	{
+		std::string s = std::to_string(value);
+		for (int i = (int)s.size() - 3; i > 0; i -= 3)
+			s.insert(i, ".");
+		return s;
+	}
+
+	std::string signedDots(long long value)
+	{
+		if (value == 0) return "";
+		return std::string(value > 0 ? "+" : "-") + withDots((unsigned long long)std::llabs(value));
+	}
+
+	std::string formatFloat(float value, int decimals)
+	{
+		char buf[64];
+		snprintf(buf, sizeof(buf), "%.*f", decimals, value);
+		std::string s(buf);
+		for (char &c : s)
+		{
+			if (c == '.') c = ',';
+		}
+		return s;
+	}
+
+	struct Cell
+	{
+		std::string value;
+		std::string delta;
+		int deltaSign = 0; // +1 green, -1 red, 0 grey
+	};
+
+	int globalPlaceOnMap(unsigned long long score)
+	{
+		std::vector<OsuDatabase::Score> globalScores;
+		if (!OsuBanchoApi::getBeatmapScores(g_beatmapID, globalScores) || globalScores.empty())
+			return 0;
+
+		// best score per player, then count everyone who is better
+		std::vector<std::string> seen;
+		int better = 0;
+		std::sort(globalScores.begin(), globalScores.end(), [](const OsuDatabase::Score &a, const OsuDatabase::Score &b) {return a.score > b.score;});
+		for (const OsuDatabase::Score &s : globalScores)
+		{
+			const std::string n = std::string(s.playerName.toUtf8());
+			if (std::find(seen.begin(), seen.end(), n) != seen.end()) continue;
+			seen.push_back(n);
+			if (s.score > score) better++;
+		}
+		return better + 1;
+	}
+}
+
+void OsuResultStats::captureBefore(Osu *osu)
+{
+	if (osu == NULL) return;
+	g_osu = osu;
+	g_before = computeOverall(osu);
+	g_bValid = false;
+}
+
+void OsuResultStats::captureAfter(Osu *osu, const OsuDatabase::Score &score, int scoreIndex, int beatmapID)
+{
+	if (osu == NULL || scoreIndex < 0) return;
+	g_osu = osu;
+	g_after = computeOverall(osu);
+
+	g_playScore = score.score;
+	g_playCombo = score.comboMax;
+	g_playAccuracy = OsuScore::calculateAccuracy(score.num300s, score.num100s, score.num50s, score.numMisses);
+	g_playPP = score.pp;
+	g_localPlace = scoreIndex + 1;
+	g_beatmapID = beatmapID;
+	g_bNewBest = (scoreIndex == 0);
+	g_bValid = true;
+
+	// start loading the rank for the new pp right away
+	OsuBanchoApi::setLocalPP(g_after.pp);
+}
+
+void OsuResultStats::setShowing(bool showing)
+{
+	g_bShowing = showing;
+}
+
+bool OsuResultStats::isShowing()
+{
+	return g_bShowing && g_bValid;
+}
+
+void OsuResultStats::draw(Graphics *g, float x, float y, float width, float height)
+{
+	if (!isShowing() || g_osu == NULL) return;
+
+	McFont *font = g_osu->getSubTitleFont();
+
+	// ---------------------------------------------------------------- values
+	const char *headers[6] = {"Rank", "Accuracy", "Max Combo", "Ranked Score", "Total Score", "Performance"};
+
+	Cell play[6];
+	{
+		const int globalPlace = globalPlaceOnMap(g_playScore);
+		if (globalPlace > 0)
+		{
+			play[0].value = "#" + std::to_string(globalPlace);
+			play[0].delta = "global";
+		}
+		else
+		{
+			play[0].value = "#" + std::to_string(g_localPlace);
+			play[0].delta = "local";
+		}
+		play[0].deltaSign = 0;
+
+		play[1].value = formatFloat(g_playAccuracy*100.0f, 2) + "%";
+		play[2].value = withDots(g_playCombo) + "x";
+		play[3].value = withDots(g_playScore);
+		play[4].value = withDots(g_playScore);
+		play[5].value = std::to_string((int)std::round(g_playPP)) + "pp";
+		for (int i=1; i<6; i++)
+		{
+			play[i].delta = (g_bNewBest ? "new!" : "");
+			play[i].deltaSign = (g_bNewBest ? 1 : 0);
+		}
+	}
+
+	Cell overall[6];
+	{
+		int rankBefore = 0, rankAfter = 0;
+		bool estBefore = false, estAfter = false;
+		const bool haveBefore = OsuBanchoApi::getCachedRank(g_before.pp, rankBefore, estBefore);
+		const bool haveAfter = OsuBanchoApi::getCachedRank(g_after.pp, rankAfter, estAfter);
+		if (haveAfter)
+		{
+			overall[0].value = std::string(estAfter ? "~" : "") + "#" + withDots(rankAfter);
+			if (haveBefore && rankBefore != rankAfter)
+			{
+				const long long gained = (long long)rankBefore - (long long)rankAfter;
+				overall[0].delta = signedDots(gained);
+				overall[0].deltaSign = (gained > 0 ? 1 : -1);
+			}
+		}
+		else
+			overall[0].value = "...";
+
+		const float accDelta = (g_after.accuracy - g_before.accuracy)*100.0f;
+		overall[1].value = formatFloat(g_after.accuracy*100.0f, 2) + "%";
+		if (std::fabs(accDelta) >= 0.005f)
+		{
+			overall[1].delta = std::string(accDelta > 0 ? "+" : "") + formatFloat(accDelta, 2) + "%";
+			overall[1].deltaSign = (accDelta > 0 ? 1 : -1);
+		}
+
+		overall[2].value = withDots(g_after.maxCombo) + "x";
+		if (g_after.maxCombo > g_before.maxCombo)
+		{
+			overall[2].delta = signedDots((long long)g_after.maxCombo - (long long)g_before.maxCombo);
+			overall[2].deltaSign = 1;
+		}
+
+		overall[3].value = withDots(g_after.rankedScore);
+		overall[3].delta = signedDots((long long)g_after.rankedScore - (long long)g_before.rankedScore);
+		overall[3].deltaSign = (g_after.rankedScore >= g_before.rankedScore ? 1 : -1);
+
+		overall[4].value = withDots(g_after.totalScore);
+		overall[4].delta = signedDots((long long)g_after.totalScore - (long long)g_before.totalScore);
+		overall[4].deltaSign = 1;
+
+		const float ppDelta = g_after.pp - g_before.pp;
+		overall[5].value = withDots((unsigned long long)std::round(g_after.pp)) + "pp";
+		if (std::fabs(ppDelta) >= 0.5f)
+		{
+			overall[5].delta = std::string(ppDelta > 0 ? "+" : "") + std::to_string((int)std::round(ppDelta)) + "pp";
+			overall[5].deltaSign = (ppDelta > 0 ? 1 : -1);
+		}
+	}
+
+	// ---------------------------------------------------------------- layout
+	const float margin = height*0.08f;
+	const float tableX = x + width*0.06f;
+	const float tableW = width*0.88f;
+	const float labelW = tableW*0.13f;
+	const float colW = (tableW - labelW) / 6.0f;
+	const float headerH = height*0.16f;
+	const float rowH = (height - 2*margin - headerH) / 2.0f;
+	const float tableY = y + margin;
+
+	auto drawText = [&](const std::string &text, float cx, float cy, float maxHeight, Color color, bool center) {
+		if (text.empty()) return;
+		const UString u(text.c_str());
+		float scale = maxHeight / font->getHeight();
+		const float maxWidth = colW*0.92f;
+		if (font->getStringWidth(u)*scale > maxWidth)
+			scale = maxWidth / font->getStringWidth(u);
+		const float w = font->getStringWidth(u)*scale;
+		g->pushTransform();
+		{
+			g->scale(scale, scale);
+			g->translate((int)(center ? cx - w/2.0f : cx), (int)(cy + font->getHeight()*scale/2.0f));
+			g->setColor(color);
+			g->drawString(font, u);
+		}
+		g->popTransform();
+	};
+
+	// background
+	g->setColor(0xcc111111);
+	g->fillRoundedRect((int)tableX, (int)tableY, (int)tableW, (int)(headerH + 2*rowH), (int)(height*0.04f));
+
+	// header
+	g->setColor(0xff222222);
+	g->fillRect((int)(tableX + labelW), (int)tableY, (int)(tableW - labelW), (int)headerH);
+	for (int i=0; i<6; i++)
+		drawText(headers[i], tableX + labelW + colW*i + colW/2.0f, tableY + headerH/2.0f, headerH*0.55f, 0xffffffff, true);
+
+	// rows
+	const char *rowLabels[2] = {"This play", "Overall"};
+	const Color rowColors[2] = {0xff1b7fb6, 0xff4f8a1d};
+	const Color labelColors[2] = {0xffffb000, 0xffffb000};
+	Cell *rows[2] = {play, overall};
+	for (int r=0; r<2; r++)
+	{
+		const float rowY = tableY + headerH + rowH*r;
+
+		g->setColor(0xff1a1206);
+		g->fillRect((int)tableX, (int)(rowY + 2), (int)labelW, (int)(rowH - 4));
+		drawText(rowLabels[r], tableX + labelW/2.0f, rowY + rowH/2.0f, rowH*0.3f, labelColors[r], true);
+
+		for (int c=0; c<6; c++)
+		{
+			const float cellX = tableX + labelW + colW*c;
+			g->setColor(rowColors[r]);
+			g->fillRect((int)(cellX + 2), (int)(rowY + 2), (int)(colW - 4), (int)(rowH - 4));
+
+			const Cell &cell = rows[r][c];
+			const bool hasDelta = !cell.delta.empty();
+			drawText(cell.value, cellX + colW/2.0f, rowY + rowH*(hasDelta ? 0.33f : 0.5f), rowH*0.3f, 0xffffffff, true);
+			if (hasDelta)
+			{
+				const Color deltaColor = (cell.deltaSign > 0 ? 0xffb6ff8a : (cell.deltaSign < 0 ? 0xffff8a8a : 0xffdddddd));
+				drawText("(" + cell.delta + ")", cellX + colW/2.0f, rowY + rowH*0.72f, rowH*0.24f, deltaColor, true);
+			}
+		}
+	}
+}
