diff --git a/src/App/Osu/OsuPCoreAffinity.cpp b/src/App/Osu/OsuPCoreAffinity.cpp
new file mode 100644
index 0000000..705ca56
--- /dev/null
+++ b/src/App/Osu/OsuPCoreAffinity.cpp
@@ -0,0 +1,129 @@
+//================ myosu: run on the performance cores ================//
+//
+// Purpose:		on hybrid Intel CPUs (P-cores + E-cores) the game thread can end up
+//				on a slow core. This pins the process to the fastest cores once at
+//				startup (same as "Set affinity" in the task manager).
+//
+//===============================================================================//
+
+#include "OsuPCoreAffinity.h"
+
+#include "Engine.h"
+#include "ConVar.h"
+
+#include <windows.h>
+#include <vector>
+#include <string>
+
+ConVar osu_process_priority_realtime("osu_process_priority_realtime", false, FCVAR_NONE, "run the game with realtime priority (needs admin rights, otherwise Windows uses high), applied at startup");
+ConVar osu_cpu_affinity("osu_cpu_affinity", "0-5", FCVAR_NONE, "CPUs the game may use, like in the task manager, e.g. \"0-5\" or \"0,1,4-7\" (empty = automatic P-core detection), applied at startup");
+ConVar osu_pcore_affinity("osu_pcore_affinity", true, FCVAR_NONE, "on hybrid CPUs, only run on the performance cores (P-cores), applied at startup");
+
+namespace
+{
+	bool g_bApplied = false;
+}
+
+void OsuPCoreAffinity::applyOnce()
+{
+	if (g_bApplied) return;
+	g_bApplied = true;
+
+	// realtime priority (Windows silently falls back to high without admin rights)
+	if (osu_process_priority_realtime.getBool())
+		SetPriorityClass(GetCurrentProcess(), REALTIME_PRIORITY_CLASS);
+
+	if (!osu_pcore_affinity.getBool()) return;
+
+	// manual CPU list (same numbers as in the task manager)
+	{
+		const std::string list = std::string(osu_cpu_affinity.getString().toUtf8());
+		DWORD_PTR manualMask = 0;
+		size_t i = 0;
+		while (i < list.size())
+		{
+			while (i < list.size() && (list[i] < '0' || list[i] > '9')) i++;
+			if (i >= list.size()) break;
+			int from = 0;
+			while (i < list.size() && list[i] >= '0' && list[i] <= '9') from = from*10 + (list[i++] - '0');
+			int to = from;
+			while (i < list.size() && list[i] == ' ') i++;
+			if (i < list.size() && list[i] == '-')
+			{
+				i++;
+				while (i < list.size() && list[i] == ' ') i++;
+				to = 0;
+				while (i < list.size() && list[i] >= '0' && list[i] <= '9') to = to*10 + (list[i++] - '0');
+			}
+			for (int cpu = from; cpu <= to && cpu < (int)(sizeof(DWORD_PTR)*8); cpu++)
+				manualMask |= ((DWORD_PTR)1 << cpu);
+		}
+
+		if (manualMask != 0)
+		{
+			DWORD_PTR processMask = 0, systemMask = 0;
+			if (GetProcessAffinityMask(GetCurrentProcess(), &processMask, &systemMask))
+			{
+				manualMask &= systemMask;
+				if (manualMask != 0 && SetProcessAffinityMask(GetCurrentProcess(), manualMask))
+					debugLog("myosu: affinity set to \"%s\"\n", list.c_str());
+			}
+			return;
+		}
+	}
+
+	DWORD length = 0;
+	GetLogicalProcessorInformationEx(RelationProcessorCore, NULL, &length);
+	if (length == 0) return;
+
+	std::vector<BYTE> buffer(length);
+	if (!GetLogicalProcessorInformationEx(RelationProcessorCore, (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)buffer.data(), &length))
+		return;
+
+	// first pass: lowest/highest efficiency class, second pass: mask of every core above the lowest class
+	// (= all P-cores; some CPUs give their "favored" P-cores an even higher class, so don't only take the highest)
+	int maxClass = -1;
+	int minClass = 1000;
+	for (int pass=0; pass<2; pass++)
+	{
+		DWORD_PTR mask = 0;
+		int numCores = 0;
+		for (DWORD offset = 0; offset < length;)
+		{
+			PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX info = (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)(buffer.data() + offset);
+			if (info->Size == 0) break;
+
+			if (info->Relationship == RelationProcessorCore)
+			{
+				// PROCESSOR_RELATIONSHIP: BYTE Flags, BYTE EfficiencyClass, ... (read raw, older headers lack the field)
+				const BYTE *raw = (const BYTE *)&info->Processor;
+				const int efficiencyClass = raw[1];
+
+				if (pass == 0)
+				{
+					if (efficiencyClass > maxClass) maxClass = efficiencyClass;
+					if (efficiencyClass < minClass) minClass = efficiencyClass;
+				}
+				else if (efficiencyClass > minClass && info->Processor.GroupCount > 0 && info->Processor.GroupMask[0].Group == 0)
+				{
+					mask |= (DWORD_PTR)info->Processor.GroupMask[0].Mask;
+					numCores++;
+				}
+			}
+			offset += info->Size;
+		}
+
+		if (pass == 1)
+		{
+			// only on hybrid CPUs (all cores in the same class = nothing to do)
+			DWORD_PTR processMask = 0, systemMask = 0;
+			if (maxClass <= minClass || numCores == 0 || mask == 0) return;
+			if (!GetProcessAffinityMask(GetCurrentProcess(), &processMask, &systemMask)) return;
+			mask &= systemMask;
+			if (mask == 0 || mask == systemMask) return;
+
+			if (SetProcessAffinityMask(GetCurrentProcess(), mask))
+				debugLog("myosu: pinned to %i performance cores (mask 0x%llx)\n", numCores, (unsigned long long)mask);
+		}
+	}
+}
