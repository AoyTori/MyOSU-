+bool fileExists(const std::string &path)
+{
+	std::ifstream test(path.c_str(), std::ios::binary);
+	return test.good();
+}
+
+Image *loadAvatarFor(const std::string &playerName)
+{
+	AvatarEntry &entry = g_avatars[playerName];
+	if (entry.loaded) return entry.image;
+	if (engine->getTime() < entry.lastCheckTime + 5.0) return NULL;
+	entry.lastCheckTime = engine->getTime();
+
+	// own picture of this profile first, then the old shared avatar.png/.jpg
+	const std::string base = avatarBaseName(playerName);
+	const std::string candidates[] = {base + ".png", base + ".jpg", "avatar.png", "avatar.jpg", "avatar.jpeg"};
+	for (const std::string &fileName : candidates)
+	{
+		if (!fileExists(fileName)) continue;
+
+		char fullPath[MAX_PATH];
+		if (_fullpath(fullPath, fileName.c_str(), MAX_PATH) != NULL)
+		{
+			entry.image = engine->getResourceManager()->loadImageAbsUnnamed(UString(fullPath), true);
+			entry.loaded = true;
+		}
+		return entry.image;
+	}
+	return NULL;
+}
