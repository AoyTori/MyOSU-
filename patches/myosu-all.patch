+//================ myosu: osu! API v2 (read-only, offline client) ================//
+//
+// Purpose:		estimates where the local (offline) pp would rank on Bancho by
+//				looking it up in the official osu! API v2 performance rankings
+//				(client credentials, read-only). Nothing is ever submitted.
+//				Also loads a custom profile picture from the game folder.
+//
+//===============================================================================//
+
+#ifndef OSUBANCHOAPI_H
+#define OSUBANCHOAPI_H
+
+#include "cbase.h"
+#include "OsuDatabase.h"
+
+class Image;
+
+class OsuBanchoApi
+{
+public:
+	static void update(); // call every frame from the main thread
+
+	static void setLocalPP(float pp); // weighted local pp of the current player
+
+	static int getGlobalRank();  // 0 = unknown
+	static int getCountryRank(); // 0 = unknown
+	static bool isGlobalRankEstimated();  // beyond the top 10.000 (the API does not list those players)
+	static bool isCountryRankEstimated();
+	static bool getCachedRank(float pp, int &globalRank, bool &estimated); // false if not loaded (yet)
+	static UString getCountryCode();
+	static UString getStatus();  // empty if everything is fine
+
+	static Image *getAvatar(UString playerName); // profile picture of this profile (avatars/<name>.png/.jpg, fallback avatar.png), or NULL
+	static void chooseAvatar();  // file dialog, the picture is saved for the current profile
+
+	// global top 50 of a ranked beatmap (fetched in the background, cached)
+	static bool getBeatmapScores(int beatmapID, std::vector<OsuDatabase::Score> &out);
+	static bool consumeLeaderboardChanged(); // true once after new scores have arrived
+};
+
+#endif
