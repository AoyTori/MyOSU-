diff --git a/src/App/Osu/OsuAoyMode.cpp b/src/App/Osu/OsuAoyMode.cpp
new file mode 100644
index 0000000..42898ef
--- /dev/null
+++ b/src/App/Osu/OsuAoyMode.cpp
@@ -0,0 +1,184 @@
+//================ myosu: Aoy mode ================//
+//
+// Purpose:		while playing: CS 0 (HR: 1.5), AR 10.3, OD 10 (HR: 11).
+//				Displayed values, stars and pp stay the normal ones of the map
+//				(nomod or HR), as if it was played normally.
+//				Every Aoy play also remembers its "real" values, so turning the
+//				mode off switches those scores back to the real pp (and on again).
+//
+//===============================================================================//
+
+#include "OsuAoyMode.h"
+
+#include "Engine.h"
+#include "ConVar.h"
+
+#include "Osu.h"
+#include "OsuSongBrowser2.h"
+#include "OsuDatabase.h"
+
+#include <fstream>
+#include <sstream>
+#include <vector>
+#include <cstdlib>
+
+ConVar osu_aoy_mode("osu_aoy_mode", false, FCVAR_NONE, "Aoy mode: play with CS 0 (HR 1.5), AR 10.3, OD 10 (HR 11) but get the normal stars/pp of the map");
+ConVar osu_aoy_cs("osu_aoy_cs", 0.0f, FCVAR_NONE, "Aoy mode CS (nomod)");
+ConVar osu_aoy_cs_hr("osu_aoy_cs_hr", 1.5f, FCVAR_NONE, "Aoy mode CS with HR");
+ConVar osu_aoy_ar("osu_aoy_ar", 10.3f, FCVAR_NONE, "Aoy mode AR");
+ConVar osu_aoy_od("osu_aoy_od", 10.0f, FCVAR_NONE, "Aoy mode OD (nomod)");
+ConVar osu_aoy_od_hr("osu_aoy_od_hr", 11.0f, FCVAR_NONE, "Aoy mode OD with HR");
+
+namespace
+{
+	const char *FILE_NAME = "myosu_aoy_scores.txt";
+
+	struct Entry
+	{
+		std::string md5;
+		unsigned long long timestamp = 0;
+		std::string playerName;
+		OsuAoyMode::Values normal;
+		OsuAoyMode::Values real;
+	};
+
+	int g_iAppliedState = -1; // -1 = nothing applied yet this session
+
+	void writeValues(std::ostream &out, const OsuAoyMode::Values &v)
+	{
+		out << v.pp << "\t" << v.stars << "\t" << v.aim << "\t" << v.speed << "\t" << v.CS << "\t" << v.AR << "\t" << v.OD;
+	}
+
+	bool readValues(std::istringstream &in, OsuAoyMode::Values &v)
+	{
+		std::string field;
+		double values[7];
+		for (int i=0; i<7; i++)
+		{
+			if (!std::getline(in, field, '\t')) return false;
+			values[i] = std::atof(field.c_str());
+		}
+		v.pp = (float)values[0];
+		v.stars = values[1];
+		v.aim = values[2];
+		v.speed = values[3];
+		v.CS = (float)values[4];
+		v.AR = (float)values[5];
+		v.OD = (float)values[6];
+		return true;
+	}
+
+	std::vector<Entry> loadEntries()
+	{
+		std::vector<Entry> entries;
+		std::ifstream file(FILE_NAME);
+		std::string line;
+		while (std::getline(file, line))
+		{
+			if (line.empty() || line[0] == '#') continue;
+			std::istringstream in(line);
+			Entry e;
+			std::string field;
+			if (!std::getline(in, e.md5, '\t')) continue;
+			if (!std::getline(in, field, '\t')) continue;
+			e.timestamp = std::strtoull(field.c_str(), NULL, 10);
+			if (!readValues(in, e.normal)) continue;
+			if (!readValues(in, e.real)) continue;
+			std::getline(in, e.playerName); // rest of the line (names may contain spaces)
+			entries.push_back(e);
+		}
+		return entries;
+	}
+
+	void applyValues(OsuDatabase::Score &score, const OsuAoyMode::Values &v)
+	{
+		score.pp = v.pp;
+		score.starsTomTotal = (float)v.stars;
+		score.starsTomAim = (float)v.aim;
+		score.starsTomSpeed = (float)v.speed;
+		score.CS = v.CS;
+		score.AR = v.AR;
+		score.OD = v.OD;
+	}
+}
+
+bool OsuAoyMode::isActive()
+{
+	return osu_aoy_mode.getBool();
+}
+
+bool OsuAoyMode::isRelaxHidden()
+{
+	static ConVar *hide = convar->getConVarByName("osu_relax_hide");
+	return osu_aoy_mode.getBool() || (hide != NULL && hide->getBool());
+}
+
+float OsuAoyMode::getCS(bool hardRock)
+{
+	return (hardRock ? osu_aoy_cs_hr.getFloat() : osu_aoy_cs.getFloat());
+}
+
+float OsuAoyMode::getAR()
+{
+	return osu_aoy_ar.getFloat();
+}
+
+float OsuAoyMode::getOD(bool hardRock)
+{
+	return (hardRock ? osu_aoy_od_hr.getFloat() : osu_aoy_od.getFloat());
+}
+
+void OsuAoyMode::recordScore(const std::string &md5, unsigned long long unixTimestamp, const std::string &playerName, const Values &normal, const Values &real)
+{
+	std::ofstream out(FILE_NAME, std::ios::app);
+	if (!out.good()) return;
+	out << md5 << "\t" << unixTimestamp << "\t";
+	writeValues(out, normal);
+	out << "\t";
+	writeValues(out, real);
+	out << "\t" << playerName << "\n";
+}
+
+void OsuAoyMode::update(Osu *osu)
+{
+	if (osu == NULL || osu->getSongBrowser() == NULL) return;
+
+	OsuDatabase *db = osu->getSongBrowser()->getDatabase();
+	if (db == NULL || !db->isFinished()) return;
+
+	const int state = (osu_aoy_mode.getBool() ? 1 : 0);
+
+	// first frame after loading: the database already holds whatever was saved last time
+	if (g_iAppliedState < 0)
+	{
+		g_iAppliedState = state;
+		return;
+	}
+	if (state == g_iAppliedState) return;
+	g_iAppliedState = state;
+
+	// switch every remembered Aoy play to the normal (on) or real (off) values
+	const std::vector<Entry> entries = loadEntries();
+	if (entries.empty()) return;
+
+	std::unordered_map<std::string, std::vector<OsuDatabase::Score>> *scores = db->getScores();
+	int changed = 0;
+	for (const Entry &e : entries)
+	{
+		std::unordered_map<std::string, std::vector<OsuDatabase::Score>>::iterator it = scores->find(e.md5);
+		if (it == scores->end()) continue;
+
+		for (OsuDatabase::Score &score : it->second)
+		{
+			if (score.unixTimestamp != e.timestamp || std::string(score.playerName.toUtf8()) != e.playerName) continue;
+			applyValues(score, state == 1 ? e.normal : e.real);
+			changed++;
+		}
+	}
+
+	if (changed > 0)
+	{
+		db->forceScoreUpdateOnNextCalculatePlayerStats();
+		db->forceScoresSaveOnNextShutdown();
+	}
+}
diff --git a/src/App/Osu/OsuAoyMode.h b/src/App/Osu/OsuAoyMode.h
new file mode 100644
index 0000000..f0441fe
--- /dev/null
+++ b/src/App/Osu/OsuAoyMode.h
@@ -0,0 +1,46 @@
+//================ myosu: Aoy mode ================//
+//
+// Purpose:		while playing: CS 0 (HR: 1.5), AR 10.3, OD 10 (HR: 11).
+//				Displayed values, stars and pp stay the normal ones of the map
+//				(nomod or HR), as if it was played normally.
+//				Every Aoy play also remembers its "real" values, so turning the
+//				mode off switches those scores back to the real pp (and on again).
+//
+//===============================================================================//
+
+#ifndef OSUAOYMODE_H
+#define OSUAOYMODE_H
+
+#include <string>
+
+class Osu;
+
+namespace OsuAoyMode
+{
+	struct Values
+	{
+		float pp = 0.0f;
+		double stars = 0.0;
+		double aim = 0.0;
+		double speed = 0.0;
+		float CS = 0.0f;
+		float AR = 0.0f;
+		float OD = 0.0f;
+	};
+
+	bool isActive();
+	bool isRelaxHidden(); // option "Hide Relax", or Aoy mode is on
+
+	// gameplay values (only used while playing)
+	float getCS(bool hardRock);
+	float getAR();
+	float getOD(bool hardRock);
+
+	// remembers both versions of a freshly saved Aoy play
+	void recordScore(const std::string &md5, unsigned long long unixTimestamp, const std::string &playerName, const Values &normal, const Values &real);
+
+	// switches the remembered plays when the mode gets toggled, call every frame
+	void update(Osu *osu);
+}
+
+#endif
diff --git a/src/App/Osu/OsuBanchoApi.cpp b/src/App/Osu/OsuBanchoApi.cpp
new file mode 100644
index 0000000..9fb96e2
--- /dev/null
+++ b/src/App/Osu/OsuBanchoApi.cpp
@@ -0,0 +1,937 @@
+//================ myosu: osu! API v2 (read-only, offline client) ================//
+//
+// Purpose:		estimates where the local (offline) pp would rank on Bancho by
+//				looking it up in the official osu! API v2 performance rankings
+//				(client credentials, read-only). Nothing is ever submitted.
+//				Also loads a custom profile picture from the game folder.
+//
+//===============================================================================//
+
+#include "OsuBanchoApi.h"
+
+#include "Engine.h"
+#include "ConVar.h"
+#include "ResourceManager.h"
+#include "Image.h"
+
+#include <windows.h>
+#include <winhttp.h>
+
+#include <string>
+#include <vector>
+#include <thread>
+#include <mutex>
+#include <atomic>
+#include <fstream>
+#include <cstdlib>
+#include <cctype>
+#include <cmath>
+#include <algorithm>
+#include <map>
+#include <ctime>
+#include <cstdio>
+#include <commdlg.h>
+
+ConVar osu_api_client_id("osu_api_client_id", "", FCVAR_NONE, "osu! API v2 OAuth client ID (osu.ppy.sh -> Settings -> OAuth -> New OAuth Application)");
+ConVar osu_api_client_secret("osu_api_client_secret", "", FCVAR_NONE, "osu! API v2 OAuth client secret");
+ConVar osu_api_global_leaderboard("osu_api_global_leaderboard", true, FCVAR_NONE, "show the global top 50 of ranked beatmaps next to your local scores");
+ConVar osu_api_osudaily_key("osu_api_osudaily_key", "", FCVAR_NONE, "osudaily.net API key (optional): exact ranks beyond the top 10.000");
+ConVar osu_api_country("osu_api_country", "", FCVAR_NONE, "two letter country code for the country rank (e.g. DE), empty = no country rank");
+
+namespace
+{
+
+// ---------------------------------------------------------------- shared state
+
+std::mutex g_mutex;
+std::atomic<bool> g_bRunning(false);
+int g_iGlobalRank = 0;        // guarded by g_mutex
+int g_iCountryRank = 0;       // guarded by g_mutex
+bool g_bGlobalEstimated = false;  // guarded by g_mutex
+struct RankResult
+{
+	int globalRank = 0;
+	int countryRank = 0;
+	bool globalEstimated = false;
+	bool countryEstimated = false;
+};
+std::map<long, RankResult> g_rankCache; // key: pp*10, guarded by g_mutex
+long ppKey(float pp) {return (long)std::lround(pp * 10.0f);}
+bool g_bCountryEstimated = false; // guarded by g_mutex
+UString g_countryCode;        // guarded by g_mutex
+UString g_status;             // guarded by g_mutex
+
+float g_fLocalPP = 0.0f;
+float g_fFetchedPP = -1.0f;
+std::string g_lastConfig;
+std::string g_fetchedConfig;
+double g_fLastConfigChangeTime = 0.0;
+double g_fLastFetchTime = -1000.0;
+
+// global leaderboards: beatmap ID -> scores
+struct LeaderboardEntry
+{
+	bool loaded = false;
+	double fetchTime = 0.0;
+	std::vector<OsuDatabase::Score> scores;
+};
+std::map<int, LeaderboardEntry> g_leaderboards;  // guarded by g_mutex
+std::atomic<bool> g_bLeaderboardRunning(false);
+std::atomic<bool> g_bLeaderboardChanged(false);
+std::string g_cachedToken;                       // guarded by g_mutex
+double g_fCachedTokenTime = -100000.0;           // guarded by g_mutex
+
+struct AvatarEntry
+{
+	Image *image = NULL;
+	bool loaded = false;
+	double lastCheckTime = -1000.0;
+};
+std::map<std::string, AvatarEntry> g_avatars; // player name -> picture (main thread only)
+
+void setStatus(const UString &status)
+{
+	std::lock_guard<std::mutex> lock(g_mutex);
+	g_status = status;
+}
+
+// ---------------------------------------------------------------- http (WinHTTP)
+
+std::wstring widen(const std::string &s)
+{
+	if (s.empty()) return std::wstring();
+	const int len = MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), NULL, 0);
+	std::wstring out(len, L'\0');
+	MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), &out[0], len);
+	return out;
+}
+
+bool httpRequest(const std::string &host, const std::string &path, const wchar_t *verb, const std::string &body, const std::string &headers, std::string &out, int &statusCode)
+{
+	out.clear();
+	statusCode = 0;
+	bool ok = false;
+
+	HINTERNET session = WinHttpOpen(L"myosu/1.0", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
+	if (session == NULL) return false;
+
+	WinHttpSetTimeouts(session, 5000, 5000, 10000, 15000);
+
+	HINTERNET connection = WinHttpConnect(session, widen(host).c_str(), INTERNET_DEFAULT_HTTPS_PORT, 0);
+	if (connection != NULL)
+	{
+		HINTERNET request = WinHttpOpenRequest(connection, verb, widen(path).c_str(), NULL, WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE);
+		if (request != NULL)
+		{
+			const std::wstring wheaders = widen(headers);
+			const BOOL sent = WinHttpSendRequest(request,
+					wheaders.empty() ? WINHTTP_NO_ADDITIONAL_HEADERS : wheaders.c_str(), wheaders.empty() ? 0 : (DWORD)-1L,
+					body.empty() ? WINHTTP_NO_REQUEST_DATA : (LPVOID)body.data(), (DWORD)body.size(), (DWORD)body.size(), 0);
+
+			if (sent && WinHttpReceiveResponse(request, NULL))
+			{
+				DWORD code = 0;
+				DWORD codeSize = sizeof(code);
+				WinHttpQueryHeaders(request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX, &code, &codeSize, WINHTTP_NO_HEADER_INDEX);
+				statusCode = (int)code;
+
+				DWORD available = 0;
+				while (WinHttpQueryDataAvailable(request, &available) && available > 0)
+				{
+					std::string chunk(available, '\0');
+					DWORD read = 0;
+					if (!WinHttpReadData(request, &chunk[0], available, &read) || read == 0)
+						break;
+					out.append(chunk.data(), read);
+				}
+				ok = true;
+			}
+			WinHttpCloseHandle(request);
+		}
+		WinHttpCloseHandle(connection);
+	}
+	WinHttpCloseHandle(session);
+	return ok;
+}
+
+std::string jsonEscape(const std::string &s)
+{
+	std::string out;
+	for (char c : s)
+	{
+		if (c == '"' || c == '\\') out += '\\';
+		out += c;
+	}
+	return out;
+}
+
+// ---------------------------------------------------------------- tiny json reader
+
+size_t skipWs(const std::string &j, size_t i)
+{
+	while (i < j.size() && (j[i] == ' ' || j[i] == '\n' || j[i] == '\r' || j[i] == '\t')) i++;
+	return i;
+}
+
+size_t skipString(const std::string &j, size_t i) // i at opening quote, returns index after closing quote
+{
+	i++;
+	while (i < j.size())
+	{
+		if (j[i] == '\\') i += 2;
+		else if (j[i] == '"') return i + 1;
+		else i++;
+	}
+	return j.size();
+}
+
+size_t skipValue(const std::string &j, size_t i)
+{
+	i = skipWs(j, i);
+	if (i >= j.size()) return i;
+	if (j[i] == '"') return skipString(j, i);
+	if (j[i] == '{' || j[i] == '[')
+	{
+		int depth = 0;
+		while (i < j.size())
+		{
+			if (j[i] == '"') { i = skipString(j, i); continue; }
+			if (j[i] == '{' || j[i] == '[') depth++;
+			else if (j[i] == '}' || j[i] == ']') { depth--; if (depth == 0) return i + 1; }
+			i++;
+		}
+		return i;
+	}
+	while (i < j.size() && j[i] != ',' && j[i] != '}' && j[i] != ']') i++;
+	return i;
+}
+
+// returns the start index of the value of "key" inside the object starting at objStart, or npos
+size_t findKey(const std::string &j, size_t objStart, const std::string &key)
+{
+	size_t i = skipWs(j, objStart);
+	if (i >= j.size() || j[i] != '{') return std::string::npos;
+	i++;
+	while (true)
+	{
+		i = skipWs(j, i);
+		if (i >= j.size() || j[i] == '}') return std::string::npos;
+		if (j[i] != '"') return std::string::npos;
+		const size_t keyEnd = skipString(j, i);
+		const std::string k = j.substr(i + 1, keyEnd - i - 2);
+		i = skipWs(j, keyEnd);
+		if (i >= j.size() || j[i] != ':') return std::string::npos;
+		i = skipWs(j, i + 1);
+		if (k == key) return i;
+		i = skipWs(j, skipValue(j, i));
+		if (i < j.size() && j[i] == ',') i++;
+	}
+}
+
+std::string rawValueAt(const std::string &j, size_t pos)
+{
+	const size_t end = skipValue(j, pos);
+	std::string raw = j.substr(pos, end - pos);
+	if (raw.size() >= 2 && raw[0] == '"')
+		raw = raw.substr(1, raw.size() - 2);
+	return raw;
+}
+
+// ---------------------------------------------------------------- rankings
+
+bool getToken(const std::string &clientId, const std::string &clientSecret, std::string &token)
+{
+	std::string response;
+	int status = 0;
+	const std::string body = "{\"client_id\":" + clientId + ",\"client_secret\":\"" + jsonEscape(clientSecret) + "\",\"grant_type\":\"client_credentials\",\"scope\":\"public\"}";
+	if (!httpRequest("osu.ppy.sh", "/oauth/token", L"POST", body, "Content-Type: application/json\r\nAccept: application/json", response, status))
+	{
+		setStatus("API: no connection to osu.ppy.sh");
+		return false;
+	}
+	if (status != 200)
+	{
+		setStatus((status == 400 || status == 401) ? "API: wrong Client ID / Secret" : "API: login failed");
+		return false;
+	}
+
+	const size_t pos = findKey(response, 0, "access_token");
+	if (pos == std::string::npos)
+	{
+		setStatus("API: unexpected response");
+		return false;
+	}
+	token = rawValueAt(response, pos);
+	return !token.empty();
+}
+
+// one page (50 players) of the osu! standard performance ranking, pp descending
+bool fetchPage(const std::string &token, const std::string &country, int page, std::vector<float> &pps)
+{
+	pps.clear();
+
+	std::string path = "/api/v2/rankings/osu/performance?cursor%5Bpage%5D=" + std::to_string(page);
+	if (!country.empty())
+		path += "&country=" + country;
+
+	std::string response;
+	int status = 0;
+	if (!httpRequest("osu.ppy.sh", path, L"GET", "", "Authorization: Bearer " + token + "\r\nAccept: application/json", response, status) || status != 200)
+		return false;
+
+	const size_t rankingPos = findKey(response, 0, "ranking");
+	if (rankingPos == std::string::npos || response[rankingPos] != '[')
+		return true; // valid, but empty
+
+	size_t i = skipWs(response, rankingPos + 1);
+	while (i < response.size() && response[i] == '{')
+	{
+		const size_t ppPos = findKey(response, i, "pp");
+		if (ppPos != std::string::npos)
+			pps.push_back((float)std::atof(rawValueAt(response, ppPos).c_str()));
+
+		i = skipWs(response, skipValue(response, i));
+		if (i < response.size() && response[i] == ',')
+			i = skipWs(response, i + 1);
+	}
+	return true;
+}
+
+// 0 = error, -1 = outside of the 10.000 players the API exposes, otherwise the rank
+int lookupRank(const std::string &token, const std::string &country, float pp, float &boundaryPP)
+{
+	boundaryPP = 0.0f;
+	const int maxPage = 200; // the API only exposes the top 10.000 (200 pages * 50)
+	std::vector<float> pps;
+
+	// "the player would be on this page or before it": page is empty, or its last entry has less pp
+	auto playerFitsUpTo = [&](int page, bool &ok) -> bool {
+		ok = fetchPage(token, country, page, pps);
+		return ok && (pps.empty() || pps.back() < pp);
+	};
+
+	bool ok = false;
+	if (!playerFitsUpTo(maxPage, ok))
+	{
+		if (ok && !pps.empty()) boundaryPP = pps.back();
+		return ok ? -1 : 0;
+	}
+
+	int lo = 1, hi = maxPage;
+	while (lo < hi)
+	{
+		const int mid = (lo + hi) / 2;
+		if (playerFitsUpTo(mid, ok))
+			hi = mid;
+		else
+		{
+			if (!ok) return 0;
+			lo = mid + 1;
+		}
+	}
+
+	if (!fetchPage(token, country, lo, pps))
+		return 0;
+
+	if (pps.empty())
+	{
+		// past the last page of this ranking: rank is right after the last listed player
+		if (lo == 1) return 1;
+		if (!fetchPage(token, country, lo - 1, pps)) return 0;
+		return (lo - 2) * 50 + (int)pps.size() + 1;
+	}
+
+	int better = 0;
+	for (float p : pps)
+	{
+		if (p > pp) better++;
+	}
+	return (lo - 1) * 50 + better + 1;
+}
+
+bool getCachedToken(const std::string &clientId, const std::string &clientSecret, double now, std::string &token)
+{
+	{
+		std::lock_guard<std::mutex> lock(g_mutex);
+		if (!g_cachedToken.empty() && now < g_fCachedTokenTime + 3000.0)
+		{
+			token = g_cachedToken;
+			return true;
+		}
+	}
+	if (!getToken(clientId, clientSecret, token))
+		return false;
+	std::lock_guard<std::mutex> lock(g_mutex);
+	g_cachedToken = token;
+	g_fCachedTokenTime = now;
+	return true;
+}
+
+int modsFromAcronym(const std::string &m)
+{
+	if (m == "NF") return 1;
+	if (m == "EZ") return 2;
+	if (m == "TD") return 4;
+	if (m == "HD") return 8;
+	if (m == "HR") return 16;
+	if (m == "SD") return 32;
+	if (m == "DT") return 64;
+	if (m == "RX") return 128;
+	if (m == "HT") return 256;
+	if (m == "NC") return 512 | 64;
+	if (m == "FL") return 1024;
+	if (m == "SO") return 4096;
+	if (m == "AP") return 8192;
+	if (m == "PF") return 16384 | 32;
+	return 0;
+}
+
+uint64_t parseIsoTime(const std::string &iso)
+{
+	struct tm t = {};
+	if (sscanf(iso.c_str(), "%d-%d-%dT%d:%d:%d", &t.tm_year, &t.tm_mon, &t.tm_mday, &t.tm_hour, &t.tm_min, &t.tm_sec) != 6)
+		return 0;
+	t.tm_year -= 1900;
+	t.tm_mon -= 1;
+	const time_t result = _mkgmtime(&t);
+	return (result > 0 ? (uint64_t)result : 0);
+}
+
+int intField(const std::string &j, size_t obj, const char *key, int fallback = 0)
+{
+	const size_t pos = findKey(j, obj, key);
+	if (pos == std::string::npos) return fallback;
+	const std::string raw = rawValueAt(j, pos);
+	if (raw == "null" || raw.empty()) return fallback;
+	return std::atoi(raw.c_str());
+}
+
+void leaderboardWorker(std::string clientId, std::string clientSecret, int beatmapID, double now)
+{
+	std::string token;
+	std::vector<OsuDatabase::Score> scores;
+	bool ok = getCachedToken(clientId, clientSecret, now, token);
+
+	if (ok)
+	{
+		std::string response;
+		int status = 0;
+		ok = httpRequest("osu.ppy.sh", "/api/v2/beatmaps/" + std::to_string(beatmapID) + "/scores?mode=osu&limit=100", L"GET", "", "Authorization: Bearer " + token + "\r\nAccept: application/json\r\nx-api-version: 20220705", response, status);
+		if (ok && status == 200)
+		{
+			const size_t scoresPos = findKey(response, 0, "scores");
+			if (scoresPos != std::string::npos && response[scoresPos] == '[')
+			{
+				size_t i = skipWs(response, scoresPos + 1);
+				while (i < response.size() && response[i] == '{')
+				{
+					OsuDatabase::Score sc;
+					sc.isLegacyScore = false;
+					sc.isImportedLegacyScore = true; // shows pp, no custom McOsu values
+					sc.version = 777777; // myosu: marks Bancho scores
+
+					// statistics (old and new API formats)
+					const size_t statsPos = findKey(response, i, "statistics");
+					if (statsPos != std::string::npos)
+					{
+						sc.num300s = intField(response, statsPos, "count_300", intField(response, statsPos, "great"));
+						sc.num100s = intField(response, statsPos, "count_100", intField(response, statsPos, "ok"));
+						sc.num50s = intField(response, statsPos, "count_50", intField(response, statsPos, "meh"));
+						sc.numMisses = intField(response, statsPos, "count_miss", intField(response, statsPos, "miss"));
+						sc.numGekis = intField(response, statsPos, "count_geki");
+						sc.numKatus = intField(response, statsPos, "count_katu");
+					}
+					else
+						sc.num300s = sc.num100s = sc.num50s = sc.numMisses = sc.numGekis = sc.numKatus = 0;
+
+					// score: stable scores have a legacy (classic) total; lazer-only scores get converted to classic
+					size_t pos = findKey(response, i, "legacy_total_score");
+					unsigned long long legacyScore = (pos != std::string::npos ? std::strtoull(rawValueAt(response, pos).c_str(), NULL, 10) : 0);
+					if (legacyScore == 0)
+					{
+						pos = findKey(response, i, "score");
+						if (pos != std::string::npos) legacyScore = std::strtoull(rawValueAt(response, pos).c_str(), NULL, 10);
+					}
+					// lazer-only scores have no classic score: leave them out instead of guessing one
+					if (legacyScore == 0)
+					{
+						i = skipWs(response, skipValue(response, i));
+						if (i < response.size() && response[i] == ',') i = skipWs(response, i + 1);
+						continue;
+					}
+					sc.score = legacyScore;
+
+					sc.comboMax = intField(response, i, "max_combo");
+					pos = findKey(response, i, "perfect");
+					if (pos == std::string::npos) pos = findKey(response, i, "legacy_perfect");
+					sc.perfect = (pos != std::string::npos && rawValueAt(response, pos) == "true");
+
+					pos = findKey(response, i, "pp");
+					sc.pp = (pos != std::string::npos ? (float)std::atof(rawValueAt(response, pos).c_str()) : 0.0f);
+
+					// mods: ["HD","HR"] or [{"acronym":"HD"}, ...]
+					sc.modsLegacy = 0;
+					pos = findKey(response, i, "mods");
+					if (pos != std::string::npos && response[pos] == '[')
+					{
+						size_t m = skipWs(response, pos + 1);
+						while (m < response.size() && response[m] != ']')
+						{
+							if (response[m] == '"')
+								sc.modsLegacy |= modsFromAcronym(rawValueAt(response, m));
+							else if (response[m] == '{')
+							{
+								const size_t acronymPos = findKey(response, m, "acronym");
+								if (acronymPos != std::string::npos)
+									sc.modsLegacy |= modsFromAcronym(rawValueAt(response, acronymPos));
+							}
+							m = skipWs(response, skipValue(response, m));
+							if (m < response.size() && response[m] == ',') m = skipWs(response, m + 1);
+						}
+					}
+
+					const size_t userPos = findKey(response, i, "user");
+					std::string name = "?";
+					if (userPos != std::string::npos)
+					{
+						const size_t namePos = findKey(response, userPos, "username");
+						if (namePos != std::string::npos) name = rawValueAt(response, namePos);
+					}
+					sc.playerName = UString(name.c_str());
+
+					pos = findKey(response, i, "created_at");
+					if (pos == std::string::npos) pos = findKey(response, i, "ended_at");
+					sc.unixTimestamp = (pos != std::string::npos ? parseIsoTime(rawValueAt(response, pos)) : 0);
+
+					sc.numSliderBreaks = 0;
+					sc.unstableRate = sc.hitErrorAvgMin = sc.hitErrorAvgMax = 0.0f;
+					sc.starsTomTotal = sc.starsTomAim = sc.starsTomSpeed = 0.0f;
+					sc.speedMultiplier = ((sc.modsLegacy & 64) ? 1.5f : ((sc.modsLegacy & 256) ? 0.75f : 1.0f));
+					sc.CS = sc.AR = sc.OD = sc.HP = 0.0f;
+					sc.maxPossibleCombo = 0;
+					sc.numHitObjects = sc.num300s + sc.num100s + sc.num50s + sc.numMisses;
+					sc.numCircles = 0;
+					sc.sortHack = 0;
+
+					scores.push_back(sc);
+
+					i = skipWs(response, skipValue(response, i));
+					if (i < response.size() && response[i] == ',') i = skipWs(response, i + 1);
+				}
+			}
+		}
+		else
+			ok = false;
+	}
+
+	{
+		std::lock_guard<std::mutex> lock(g_mutex);
+		LeaderboardEntry &entry = g_leaderboards[beatmapID];
+		entry.loaded = true;
+		entry.fetchTime = now;
+		if (ok) entry.scores = scores;
+	}
+
+	g_bLeaderboardChanged = true;
+	g_bLeaderboardRunning = false;
+}
+
+// rough osu! standard pp distribution (rank, pp), scaled to the real pp of the 10.000th player
+double estimateGlobalRank(float pp, float pp10k)
+{
+	static const double anchors[][2] = {
+		{10000, 7600}, {25000, 5800}, {50000, 4800}, {100000, 3900}, {250000, 2600},
+		{500000, 1700}, {1000000, 900}, {2000000, 350}, {3000000, 120}, {4000000, 20}
+	};
+	const int numAnchors = sizeof(anchors) / sizeof(anchors[0]);
+	const double scale = (pp10k > 0.0f ? pp10k / anchors[0][1] : 1.0);
+
+	if (pp >= anchors[0][1]*scale) return anchors[0][0];
+	for (int i=1; i<numAnchors; i++)
+	{
+		const double hiPP = anchors[i-1][1]*scale;
+		const double loPP = anchors[i][1]*scale;
+		if (pp >= loPP)
+		{
+			const double t = (hiPP - pp) / (hiPP - loPP);
+			return std::exp(std::log(anchors[i-1][0]) + t*(std::log(anchors[i][0]) - std::log(anchors[i-1][0])));
+		}
+	}
+	return anchors[numAnchors-1][0];
+}
+
+// exact global rank for a pp value from osudaily.net (needs a free osudaily API key), 0 on error
+int osudailyRank(const std::string &key, float pp)
+{
+	if (key.empty() || pp <= 0.0f) return 0;
+
+	char ppString[32];
+	snprintf(ppString, sizeof(ppString), "%.2f", pp);
+	const std::string query = "?k=" + key + "&t=pp&v=" + std::string(ppString) + "&m=0";
+
+	const char *paths[] = {"/api/pp.php", "/api/pp"};
+	for (const char *path : paths)
+	{
+		std::string response;
+		int status = 0;
+		if (!httpRequest("osudaily.net", std::string(path) + query, L"GET", "", "Accept: application/json", response, status) || status != 200)
+			continue;
+
+		const size_t pos = findKey(response, skipWs(response, 0), "rank");
+		if (pos == std::string::npos) continue;
+		const int rank = std::atoi(rawValueAt(response, pos).c_str());
+		if (rank > 0) return rank;
+	}
+	return 0;
+}
+
+void rankWorker(std::string clientId, std::string clientSecret, std::string country, float pp, std::string osudailyKey)
+{
+	std::string token;
+	if (!getToken(clientId, clientSecret, token))
+	{
+		g_bRunning = false;
+		return;
+	}
+
+	float globalBoundaryPP = 0.0f;
+	int globalRank = 0;
+	bool globalEstimated = false;
+
+	// osudaily (if a key is set): exact global rank with a single request
+	const int osudailyGlobal = osudailyRank(osudailyKey, pp);
+	if (osudailyGlobal > 0)
+		globalRank = osudailyGlobal;
+	else
+	{
+		globalRank = lookupRank(token, "", pp, globalBoundaryPP);
+		if (globalRank == -1)
+		{
+			globalRank = (int)std::round(estimateGlobalRank(pp, globalBoundaryPP));
+			globalEstimated = true;
+		}
+	}
+
+	int countryRank = 0;
+	bool countryEstimated = false;
+	if (!country.empty())
+	{
+		float countryBoundaryPP = 0.0f;
+		countryRank = lookupRank(token, country, pp, countryBoundaryPP);
+		if (countryRank == -1)
+		{
+			// assume the country has the same share of players at every pp level
+			double globalAtCountryBoundary = 0.0;
+			if (!osudailyKey.empty())
+			{
+				Sleep(1100); // osudaily asks for at most 1 request per second
+				globalAtCountryBoundary = osudailyRank(osudailyKey, countryBoundaryPP);
+			}
+			if (globalAtCountryBoundary <= 0.0)
+				globalAtCountryBoundary = estimateGlobalRank(countryBoundaryPP, globalBoundaryPP);
+			const double ratio = (globalAtCountryBoundary > 10000.0 ? 10000.0 / globalAtCountryBoundary : 1.0);
+			if (globalBoundaryPP <= 0.0f)
+			{
+				// osudaily gave us the global rank: still need the pp of the global #10.000 for the estimate fallback
+				std::vector<float> pps;
+				if (fetchPage(token, "", 200, pps) && !pps.empty()) globalBoundaryPP = pps.back();
+			}
+			const double globalForPP = (globalEstimated ? estimateGlobalRank(pp, globalBoundaryPP) : (double)globalRank);
+			countryRank = (int)std::round(std::max(10001.0, globalForPP * ratio));
+			countryEstimated = true;
+		}
+	}
+
+	{
+		std::lock_guard<std::mutex> lock(g_mutex);
+		if (globalRank > 0)
+		{
+			RankResult result;
+			result.globalRank = globalRank;
+			result.countryRank = countryRank;
+			result.globalEstimated = globalEstimated;
+			result.countryEstimated = countryEstimated;
+			g_rankCache[ppKey(pp)] = result;
+		}
+		g_countryCode = UString(country.c_str());
+		g_status = (globalRank == 0 ? "API: could not load rankings" : "");
+	}
+
+	g_bRunning = false;
+}
+
+std::string upper(std::string s)
+{
+	for (char &c : s)
+	{
+		c = (char)toupper((unsigned char)c);
+	}
+	return s;
+}
