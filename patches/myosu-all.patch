+std::string avatarBaseName(const std::string &playerName)
+{
+	std::string safe = playerName;
+	for (char &c : safe)
+	{
+		if (c == '\\' || c == '/' || c == ':' || c == '*' || c == '?' || c == '"' || c == '<' || c == '>' || c == '|')
+			c = '_';
+	}
+	return "avatars/" + safe;
+}
