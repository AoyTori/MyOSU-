+void OsuBanchoApi::chooseAvatar()
+{
+	wchar_t fileName[MAX_PATH] = L"";
+
+	OPENFILENAMEW ofn;
+	ZeroMemory(&ofn, sizeof(ofn));
+	ofn.lStructSize = sizeof(ofn);
+	ofn.hwndOwner = GetActiveWindow();
+	ofn.lpstrFilter = L"Images (*.png, *.jpg)\0*.png;*.jpg;*.jpeg\0";
+	ofn.lpstrFile = fileName;
+	ofn.nMaxFile = MAX_PATH;
+	ofn.lpstrTitle = L"Choose profile picture";
+	ofn.Flags = OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST | OFN_NOCHANGEDIR;
+
+	if (!GetOpenFileNameW(&ofn))
+		return;
+
+	std::wstring source(fileName);
+	std::wstring extension;
+	const size_t dot = source.find_last_of(L'.');
+	if (dot != std::wstring::npos)
+		extension = source.substr(dot);
+	for (wchar_t &c : extension)
+	{
+		c = (wchar_t)towlower(c);
+	}
+	const wchar_t *target = (extension == L".png" ? L"avatar.png" : L"avatar.jpg");
+
+	// copy first (the picked file might be one of the old avatar files), then swap it in
+	if (!CopyFileW(source.c_str(), L"avatar.tmp", FALSE))
+		return;
+
+	if (g_avatar != NULL)
+	{
+		engine->getResourceManager()->destroyResource(g_avatar);
+		g_avatar = NULL;
+	}
+
+	DeleteFileW(L"avatar.png");
+	DeleteFileW(L"avatar.jpg");
+	DeleteFileW(L"avatar.jpeg");
+	MoveFileW(L"avatar.tmp", target);
+
+	g_bAvatarLoaded = false;
+	g_fLastAvatarCheckTime = -1000.0;
+	checkAvatar();
+}
+
+bool OsuBanchoApi::getBeatmapScores(int beatmapID, std::vector<OsuDatabase::Score> &out)
+{
+	if (beatmapID <= 0 || !osu_api_global_leaderboard.getBool()) return false;
+
+	const std::string clientId = std::string(osu_api_client_id.getString().toUtf8());
+	const std::string clientSecret = std::string(osu_api_client_secret.getString().toUtf8());
+	if (clientId.empty() || clientSecret.empty()) return false;
+
+	const double now = engine->getTime();
+	bool loaded = false;
+	bool needsFetch = false;
+	{
+		std::lock_guard<std::mutex> lock(g_mutex);
+		std::map<int, LeaderboardEntry>::iterator it = g_leaderboards.find(beatmapID);
+		if (it != g_leaderboards.end() && it->second.loaded)
+		{
+			out = it->second.scores;
+			loaded = true;
+			needsFetch = (now > it->second.fetchTime + 300.0); // refresh after 5 minutes
+		}
+		else
+			needsFetch = true;
+	}
+
+	if (needsFetch && !g_bLeaderboardRunning)
+	{
+		g_bLeaderboardRunning = true;
+		std::thread(leaderboardWorker, clientId, clientSecret, beatmapID, now).detach();
+	}
+
+	return loaded;
+}
+
+bool OsuBanchoApi::consumeLeaderboardChanged()
+{
+	return g_bLeaderboardChanged.exchange(false);
+}
