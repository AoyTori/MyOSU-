---
 src/App/Osu/Osu.cpp                         | 11 ++++++++++-
 src/App/Osu/Osu.h                           |  1 +
 src/App/Osu/OsuHUD.cpp                      |  4 ++--
 src/App/Osu/OsuModSelector.cpp              |  6 +++++-
 src/App/Osu/OsuOptionsMenu.cpp              |  2 ++
 src/App/Osu/OsuRankingScreen.cpp            |  2 +-
 src/App/Osu/OsuScore.cpp                    |  2 +-
 src/App/Osu/OsuUISongBrowserScoreButton.cpp |  2 +-
 8 files changed, 23 insertions(+), 7 deletions(-)

diff --git a/src/App/Osu/Osu.cpp b/src/App/Osu/Osu.cpp
index ac2d685..5e561e2 100644
--- a/src/App/Osu/Osu.cpp
+++ b/src/App/Osu/Osu.cpp
@@ -104,6 +104,9 @@ ConVar osu_skip_breaks_enabled("osu_skip_breaks_enabled", true, FCVAR_NONE, "ena
 ConVar osu_seek_delta("osu_seek_delta", 5, FCVAR_NONE, "how many seconds to skip backward/forward when quick seeking");
 
 ConVar osu_mods("osu_mods", "", FCVAR_NONE);
+// hidden-rx: Relax as a permanent option instead of a mod
+ConVar osu_relax_option("osu_relax_option", false, FCVAR_NONE, "play with Relax without it being a mod (survives Reset All Mods)");
+ConVar osu_relax_hide_indicator("osu_relax_hide_indicator", true, FCVAR_NONE, "never show Relax in mod icons, score lists or Discord status");
 ConVar osu_mod_touchdevice("osu_mod_touchdevice", false, FCVAR_NONE, "used for force applying touch pp nerf always");
 ConVar osu_mod_fadingcursor("osu_mod_fadingcursor", false, FCVAR_NONE);
 ConVar osu_mod_fadingcursor_combo("osu_mod_fadingcursor_combo", 50.0f, FCVAR_NONE);
@@ -299,6 +302,7 @@ Osu::Osu(Osu2 *osu2, int instanceID)
 	osu_volume_master.setCallback( fastdelegate::MakeDelegate(this, &Osu::onMasterVolumeChange) );
 	osu_volume_music.setCallback( fastdelegate::MakeDelegate(this, &Osu::onMusicVolumeChange) );
 	osu_speed_override.setCallback( fastdelegate::MakeDelegate(this, &Osu::onSpeedChange) );
+	osu_relax_option.setCallback( fastdelegate::MakeDelegate(this, &Osu::onRelaxOptionChange) );
 	osu_pitch_override.setCallback( fastdelegate::MakeDelegate(this, &Osu::onPitchChange) );
 
 	m_osu_playfield_rotation->setCallback( fastdelegate::MakeDelegate(this, &Osu::onPlayfieldChange) );
@@ -1226,7 +1230,7 @@ void Osu::updateMods()
 
 	m_bModAuto = osu_mods.getString().find("auto") != -1;
 	m_bModAutopilot = osu_mods.getString().find("autopilot") != -1;
-	m_bModRelax = osu_mods.getString().find("relax") != -1;
+	m_bModRelax = osu_mods.getString().find("relax") != -1 || osu_relax_option.getBool();
 	m_bModSpunout = osu_mods.getString().find("spunout") != -1;
 	m_bModTarget = osu_mods.getString().find("practicetarget") != -1;
 	m_bModScorev2 = osu_mods.getString().find("v2") != -1;
@@ -2752,3 +2756,8 @@ bool Osu::findIgnoreCase(const std::string &haystack, const std::string &needle)
 
 	return (it != haystack.end());
 }
+
+void Osu::onRelaxOptionChange(UString oldValue, UString newValue)
+{
+	updateMods();
+}
diff --git a/src/App/Osu/Osu.h b/src/App/Osu/Osu.h
index 3d319fe..eb4e5ab 100644
--- a/src/App/Osu/Osu.h
+++ b/src/App/Osu/Osu.h
@@ -227,6 +227,7 @@ private:
 	void onMasterVolumeChange(UString oldValue, UString newValue);
 	void onMusicVolumeChange(UString oldValue, UString newValue);
 	void onSpeedChange(UString oldValue, UString newValue);
+	void onRelaxOptionChange(UString oldValue, UString newValue);
 	void onPitchChange(UString oldValue, UString newValue);
 
 	void onPlayfieldChange(UString oldValue, UString newValue);
diff --git a/src/App/Osu/OsuHUD.cpp b/src/App/Osu/OsuHUD.cpp
index 5c30d1a..b924abb 100644
--- a/src/App/Osu/OsuHUD.cpp
+++ b/src/App/Osu/OsuHUD.cpp
@@ -348,7 +348,7 @@ void OsuHUD::draw(Graphics *g)
 	{
 		if (osu_draw_inputoverlay.getBool() && beatmapStd != NULL)
 		{
-			const bool isAutoClicking = (m_osu->getModAuto() || m_osu->getModRelax());
+			const bool isAutoClicking = m_osu->getModAuto(); // hidden-rx: key overlay + taps also in Relax (like lazer)
