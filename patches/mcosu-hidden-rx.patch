@@ -314,7 +314,7 @@ void OsuRankingScreen::draw(Graphics *g)
 		drawModImage(g, m_osu->getSkin()->getSelectionModTarget(), modPos, modPosMax);
 	if (m_bModSpunout)
 		drawModImage(g, m_osu->getSkin()->getSelectionModSpunOut(), modPos, modPosMax);
