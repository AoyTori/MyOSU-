@@ -2992,6 +2992,7 @@ void OsuSongBrowser2::rebuildScoreButtons()
 
 	// myosu: local scores + global top 50 from Bancho (ranked maps only), sorted together
 	std::vector<OsuDatabase::Score> shownScores;
+	std::vector<int> shownIndices; // place shown next to each score (empty = 1..n)
 	if (validBeatmap)
 	{
 		const std::string md5 = m_selectedBeatmap->getSelectedDifficulty2()->getMD5Hash();
@@ -3007,13 +3008,30 @@ void OsuSongBrowser2::rebuildScoreButtons()
 			m_db->sortScores(md5);
 
 			// only the best score of every player (like on Bancho)
+			std::vector<OsuDatabase::Score> uniqueScores;
 			std::vector<std::string> seenNames;
 			for (size_t s=0; s<localScores.size(); s++)
 			{
 				const std::string name = std::string(localScores[s].playerName.toUtf8());
 				if (std::find(seenNames.begin(), seenNames.end(), name) != seenNames.end()) continue;
 				seenNames.push_back(name);
-				shownScores.push_back(localScores[s]);
+				uniqueScores.push_back(localScores[s]);
+			}
+
+			// top 50 only; own scores below that are appended with the place they would have
+			for (size_t s=0; s<uniqueScores.size(); s++)
+			{
+				const bool isOwnScore = (uniqueScores[s].version != 777777);
+				if (s < 50)
+				{
+					shownScores.push_back(uniqueScores[s]);
+					shownIndices.push_back((int)s + 1);
+				}
+				else if (isOwnScore)
+				{
+					shownScores.push_back(uniqueScores[s]);
+					shownIndices.push_back((int)s + 1);
+				}
 			}
 
 			localScores = backup;
@@ -3049,14 +3067,15 @@ void OsuSongBrowser2::rebuildScoreButtons()
 		{
 			OsuUISongBrowserScoreButton *button = m_scoreButtonCache[i];
 			button->setName(UString(m_selectedBeatmap->getSelectedDifficulty2()->getMD5Hash().c_str()));
-			button->setScore(shownScores[i], m_selectedBeatmap->getSelectedDifficulty2(), i+1);
+			const int place = (i < shownIndices.size() ? shownIndices[i] : (int)i+1);
+			button->setScore(shownScores[i], m_selectedBeatmap->getSelectedDifficulty2(), place);
 			scoreButtons.push_back(button);
 		}
 
 		// add
 		for (size_t i=0; i<numScores; i++)
 		{
-			scoreButtons[i]->setIndex(i+1);
+			scoreButtons[i]->setIndex(i < shownIndices.size() ? shownIndices[i] : (int)i+1);
 			m_scoreBrowser->getContainer()->addBaseUIElement(scoreButtons[i]);
 		}
 
