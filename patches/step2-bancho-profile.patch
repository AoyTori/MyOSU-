+//================ myosu: osu! API v2 (read-only, offline client) ================//
+//
+// Purpose:		fetches the player's Bancho profile (avatar, rank, pp) via the
+//				official osu! API v2 with client credentials. Read-only, nothing
+//				is ever submitted to Bancho.
+//
+//===============================================================================//
+
+#ifndef OSUBANCHOAPI_H
+#define OSUBANCHOAPI_H
+
+#include "cbase.h"
+
+class Image;
+
+class OsuBanchoApi
+{
+public:
+	struct Profile
+	{
+		bool valid = false;
+		int userId = 0;
+		UString username;
+		UString countryCode;
+		int globalRank = 0;
+		int countryRank = 0;
+		float pp = 0.0f;
+		float accuracy = 0.0f;
+	};
+
+	static void update(); // call every frame from the main thread
+
+	static bool hasProfile();
+	static Profile getProfile();
+	static Image *getAvatar();
+	static UString getStatus();
+
+	static void forceRefresh();
+};
+
+#endif
