diff --git a/src/App/Osu/OsuRelaxOverlay.cpp b/src/App/Osu/OsuRelaxOverlay.cpp
new file mode 100644
index 0000000..f2a3f57
--- /dev/null
+++ b/src/App/Osu/OsuRelaxOverlay.cpp
@@ -0,0 +1,81 @@
+//================ myosu: lazer-style key overlay for Relax ================//
+//
+// Purpose:		with Relax, the key overlay shows the automatic clicks.
+//				Below a notes-per-second threshold only K1 is used (single tap),
+//				above it the clicks alternate between K1 and K2.
+//				Purely visual, nothing is sent to the system.
+//
+//===============================================================================//
+
+#include "OsuRelaxOverlay.h"
+
+#include "Engine.h"
+#include "ConVar.h"
+
+#include "Osu.h"
+#include "OsuHUD.h"
+#include "OsuScore.h"
+
+ConVar osu_relax_overlay_autoclick("osu_relax_overlay_autoclick", true, FCVAR_NONE, "with Relax, show the automatic clicks in the key overlay (like lazer)");
+ConVar osu_relax_overlay_alternate_nps("osu_relax_overlay_alternate_nps", 5.0f, FCVAR_NONE, "notes per second from which the Relax key overlay alternates K1/K2 (below: single tap K1)");
+
+namespace
+{
+	long g_lastClickTime = -1;
+	int g_lastKey = 2;
+	bool g_keyDown[2] = {false, false};
+	double g_releaseAt[2] = {0.0, 0.0};
+
+	void release(Osu *osu, int key)
+	{
+		if (!g_keyDown[key-1]) return;
+		g_keyDown[key-1] = false;
+		osu->getHUD()->animateInputoverlay(key, false);
+	}
+}
+
+void OsuRelaxOverlay::onAutoClick(Osu *osu, long hitTimeMS, long holdDurationMS)
+{
+	if (osu == NULL || !osu_relax_overlay_autoclick.getBool()) return;
+
+	// new attempt / seeking backwards
+	if (g_lastClickTime < 0 || hitTimeMS < g_lastClickTime)
+	{
+		g_lastClickTime = -1;
+		g_lastKey = 2;
+	}
+
+	// single tap below the threshold, alternate above it
+	const float nps = osu_relax_overlay_alternate_nps.getFloat();
+	const long interval = (g_lastClickTime >= 0 ? hitTimeMS - g_lastClickTime : 100000);
+	const bool alternate = (nps > 0.0f && interval > 0 && interval <= (long)(1000.0f / nps));
+	const int key = (alternate ? (g_lastKey == 1 ? 2 : 1) : 1);
+
+	release(osu, key); // in case it is still held from the previous note
+
+	g_keyDown[key-1] = true;
+	osu->getHUD()->animateInputoverlay(key, true);
+	osu->getScore()->addKeyCount(key);
+
+	// hold: sliders for their duration, circles briefly (shorter for fast notes)
+	float speed = osu->getSpeedMultiplier();
+	if (speed <= 0.0f) speed = 1.0f;
+	long holdMS = (holdDurationMS > 0 ? holdDurationMS : 60);
+	if (holdDurationMS <= 0 && interval < 120)
+		holdMS = (interval/2 > 15 ? interval/2 : 15);
+	g_releaseAt[key-1] = engine->getTime() + (holdMS / 1000.0) / speed;
+
+	g_lastClickTime = hitTimeMS;
+	g_lastKey = key;
+}
+
+void OsuRelaxOverlay::update(Osu *osu)
+{
+	if (osu == NULL) return;
+
+	for (int key=1; key<=2; key++)
+	{
+		if (g_keyDown[key-1] && engine->getTime() >= g_releaseAt[key-1])
+			release(osu, key);
+	}
+}
diff --git a/src/App/Osu/OsuRelaxOverlay.h b/src/App/Osu/OsuRelaxOverlay.h
new file mode 100644
index 0000000..b46ea5a
--- /dev/null
+++ b/src/App/Osu/OsuRelaxOverlay.h
@@ -0,0 +1,21 @@
+//================ myosu: lazer-style key overlay for Relax ================//
+//
+// Purpose:		with Relax, the key overlay shows the automatic clicks.
+//				Below a notes-per-second threshold only K1 is used (single tap),
+//				above it the clicks alternate between K1 and K2.
+//				Purely visual, nothing is sent to the system.
+//
+//===============================================================================//
+
+#ifndef OSURELAXOVERLAY_H
+#define OSURELAXOVERLAY_H
+
+class Osu;
+
+namespace OsuRelaxOverlay
+{
+	void onAutoClick(Osu *osu, long hitTimeMS, long holdDurationMS); // called when Relax hits a circle/slider head
+	void update(Osu *osu); // releases the overlay keys again, call every frame
+}
+
+#endif
